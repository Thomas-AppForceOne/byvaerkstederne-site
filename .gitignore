# OS
.DS_Store
Thumbs.db

# Design files
Stitch-designs

# Grav cache & compiled
config/www/cache/
config/www/logs/
config/www/tmp/
config/www/backup/
config/www/assets/

# Grav vendor (installed at container runtime)
config/www/vendor/
config/www/bin/

# Migration runner vendor (installed via `composer install` in
# migrations/; reproducible from migrations/composer.lock)
migrations/vendor/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Docker volumes (runtime data)
config/log/
config/keys/
config/crontabs/
config/custom-cont-init.d/
config/custom-services.d/

# Local env overrides
.env.local
.env.deploy

# Deploy staging and cached downloads
deploy/staging/
deploy/*.zip

# Auto-generated build-number markers — written by deploy/deploy.sh
# from `git rev-list --count HEAD` and shipped in the deploy package,
# never committed (they're a function of the commit, so committing
# would be a chicken-and-egg loop). See specifications/semantic_versioning_specification.md.
apex/BUILD
config/www/BUILD

# Backups (stored locally, not in git)
backups/

# Restore-to-scratch staging directories — never committed; contain
# decrypted PII and bug-report screenshots. The script paths
# operators choose at invocation (`restore.sh --to <dir>`,
# `RESTORE_LOCAL_TIER_DIR=<dir>`) vary, so we can't pre-list them
# here. The two below are kept as defensive cover in case an
# operator manually creates them — the scripts themselves never
# write to those exact paths.
deploy/staging-stage/
deploy/prod-stage/

# Restore-operation logs (per-tier, per-timestamp).
logs/restore-*.log

# User accounts (all excluded — use 'make create-admin' to bootstrap)
config/www/user/accounts/*
!config/www/user/accounts/.gitkeep

# Flex Objects indexes (auto-generated)
config/www/user/data/flex/indexes/

# Scheduler data (runtime)
config/www/user/data/scheduler/

# Notifications (runtime)
config/www/user/data/notifications/

# Remember-me tokens (runtime auth state)
config/www/user/data/rememberme/

# Feed cache
config/www/user/data/feed/

# Bug-report uploaded screenshots — runtime user uploads (the bug-report tests
# also create these). Keep the access-control infra (.htaccess + index.html);
# never track the uploaded images themselves.
config/www/user/data/bug-report-images/*
!config/www/user/data/bug-report-images/.htaccess
!config/www/user/data/bug-report-images/index.html

# Claude Code — ignore by default, but track project-level settings + hooks.
# Local per-operator state (permissions, worktree registry, transient
# scratch files) stays ignored via the patterns below.
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/settings.local.json
.claude/launch.json
.claude/worktrees/

# Node / Playwright
node_modules/
playwright-report/
test-results/
.env.test

# Adev workspace (local AI tooling state — not project artefacts)
.adev-workspace/

# GAN harness runtime state (regenerated each run — not project artefacts)
.gan/
.gan-state/
.gan-cache/

# Per-tier security.yaml — auto-generated by Grav at first request with a
# tier-specific salt. These belong to each runtime tier (dev/test/staging
# /prod), not to the repo. Committing local-tier salts would pin them as
# production values on the next deploy.
config/www/user/env/*/config/security.yaml

# Root security.yaml — same class of secret. Grav regenerates it with a
# fresh per-instance salt on first request when absent (WI-3). The committed
# copy pinned a publicly-known salt into the repo / local dev / the initial
# release window; it is now untracked. See README setup notes.
config/www/user/config/security.yaml

# Per-tier SMTP transport credentials. Like security.yaml, these belong to
# each runtime tier, not the repo (WI-1). Provisioned out of band and wired
# into each release by deploy.sh. They live under config/plugins/ so Grav's
# environment merge folds them into the `plugins.email` namespace (the email
# plugin's config); a sibling-of-config/ file would land in a dead namespace.
# The `.example` provisioning templates are tracked (the negation keeps them).
config/www/user/env/*/config/plugins/email.yaml
!config/www/user/env/*/config/plugins/email.yaml.example

# review-and-plan / execute-fix-plan run artifacts (per-diff scratch — not
# project artefacts; regenerated each run).
.review-runs/

# spec-review-and-plan / spec-execute-fix-plan run artifacts (transient).
.spec-review-runs/

# promote-to-prod operator journal — operator-local audit trail, may carry
# sensitive --reason context. Kept on the operator's machine, never committed.
deploy/promotion-log.jsonl

# Event-manager audit trail — live state written by the plugin, per-tier, never committed
config/www/user/data/flex-objects/events-audit.jsonl

# Event RSVP signups — live per-tier state written by the plugin, never committed
config/www/user/data/flex-objects/event-signups.yaml

# Event-details uploaded images — runtime user uploads (the RSVP tests also
# create these), per-event subfolders with random filenames; never track them.
config/www/user/data/event-images/
# Account-manager runtime state (audit trail + write lock) — live per-tier
# state written by the plugin, never committed
config/www/user/data/account-manager/
