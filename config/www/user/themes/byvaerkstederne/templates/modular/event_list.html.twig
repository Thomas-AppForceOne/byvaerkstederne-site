{% set h = page.header %}
<section class="bv-section--sm">
    <div class="bv-container">
        <div class="bv-event-list__head">
            <h2 class="bv-headline" style="font-size: 1.75rem;">{{ h.section_title|default('Kommende Aktiviteter') }}</h2>
            {# Contextual arrangør affordance — UX only (the handler contract is
               the boundary); hidden from anonymous and from members without the
               events capability. Only "Arrangørpanel" lives here (gates on
               read, same as the footer entry); creating an event happens from
               the Arrangørpanel itself, so the calendar no longer carries an
               "Opret begivenhed" button. #}
            {% set _can_read = grav.user.authorize('admin.events.read') or grav.user.authorize('admin.super') %}
            {% if _can_read %}
                <div class="bv-event-list__head-actions">
                    <a class="bv-btn bv-btn--primary" href="/begivenheder/arrangoerpanel" data-testid="calendar-mine-link">Arrangørpanel</a>
                </div>
            {% endif %}
        </div>

        {# Pull from Flex Objects if available, fall back to page header. The
           canonical event-data shape (event.day, .month, .title, .badge,
           .time, .description, .accent, .filter, .event_type, .cta, .capacity)
           is what partials/event_card.html.twig consumes; build it here from
           whichever source has data. #}
        {% set flex = grav.get('flex_objects') %}{% set flex_dir = flex ? flex.directory('begivenheder') : null %}{% set flex_events = flex_dir ? flex_dir.collection : null %}

        {# filter_map maps the YAML 'group' field (filter ID candidates) to
           the data-filter value the calendar's filter buttons emit
           (templates/modular/calendar_filters.html.twig). Critical F1 guard:
           event.filter is fed FROM ev.group (the filter ID), event.accent is
           fed FROM ev.button_style (the colour token). Swapping these
           reproduces the v1 regression where data-group got the accent
           token and site.js's filter at site.js:687 matched nothing. #}
        {# Both the current (kreativ/groenne — what the editor and
           EventValidator persist) and the post-rename (krea/groent — the
           filter-button IDs) group keys map to the button's data-filter value,
           so an event saved with either variant filters correctly. Omitting
           the legacy keys is what left the Krea Café and Grønt BYværksted
           filters matching nothing. #}
        {% set filter_map = {makerspace: 'makerspace', krea: 'krea', kreativ: 'krea', groent: 'groent', groenne: 'groent', kulturhus: 'kulturhus', alle: 'all'} %}

        {% set events_list = [] %}
        {% if flex_events is not null %}
            {# Every published, non-archived, non-stale event renders here.
               (There is no per-event "featured/larger" treatment on the
               calendar — that mechanism was removed.) #}
            {% for key, ev in flex_events %}
                {# Auto-archive rule: an event that ran more than a day ago is
                   stale and drops off the (upcoming-activities) calendar, even
                   before the dashboard sweep persists archived=true. #}
                {% if ev.published and not ev.archived and not ev.deleted and not event_is_stale(ev.event_date) %}
                    {% set _accent = ev.button_style|default('primary') %}
                    {% set _filter = filter_map[ev.group]|default(ev.group) %}
                    {# The card's signup affordance.

                       With event_rsvp ON, partials/event_card renders a live
                       RSVP button and never looks at this value.

                       With it OFF there is nothing to link to: this used to
                       synthesise `href: '/begivenheder/' ~ key` on the claim
                       that it "opens the event's own detail page", but no such
                       page exists — pages/begivenheder/ holds only the
                       organizer CRUD routes, so that URL 302s straight back to
                       the calendar. Every event on production therefore had
                       exactly one call to action and it was a link to the page
                       you were already on. Invisible on dev and test, where the
                       flag is on and this branch never renders.

                       So: no destination, no button. Same contract the
                       page-authored branch below already follows (a CTA only
                       when label AND href both exist). tests/anonymous/
                       profile-parity.js fails on any link that redirects back
                       to the page it was rendered on. #}
                    {% set _cta = null %}
                    {% set events_list = events_list|merge([{
                        day: ev.event_date|date('j'),
                        month: ev.event_date|date('M'),
                        title: ev.title,
                        badge: ev.badge,
                        time: ev.event_time,
                        description: ev.description,
                        accent: _accent,
                        filter: _filter,
                        event_type: ev.event_type,
                        cta: _cta,
                        capacity: ev.capacity,
                        href: '/begivenheder/' ~ key,
                        key: key,
                        location: ev.location|default(''),
                        organizer: ev.owner|default(''),
                        details_html: ev.details_html|default(''),
                        sort_key: event_sort_key(ev.event_date, ev.event_time, ev.group) ~ '|' ~ '%03d'|format(loop.index)
                    }]) %}
                {% endif %}
            {% endfor %}
            {# Chronological calendar: date, then start time; simultaneous
               events follow the house workshop order (makerspace, krea,
               grønt, eventværkstedet, then fælles). The trailing loop index
               makes the key a total order, so the sort is deterministic. #}
            {% set events_list = events_list|sort_by_key('sort_key') %}
        {% else %}
            {# Page-header fallback. Each event from h.events is already in the
               canonical shape (the YAML schema mirrors the partial's contract)
               OR carries the legacy {month, day, title, group, button_*} shape
               — normalise to canonical here so the partial doesn't need to
               know which source it came from. #}
            {% for ev in (h.events|default([])) %}
                {% set _accent = ev.accent|default(ev.button_style)|default('primary') %}
                {% set _filter = ev.filter|default(filter_map[ev.group]|default(ev.group)) %}
                {% set _cta = ev.cta is defined
                    ? ev.cta
                    : ((ev.button_text and ev.button_url)
                        ? { label: ev.button_text, href: ev.button_url, variant: _accent }
                        : null) %}
                {% set events_list = events_list|merge([{
                    day: ev.day,
                    month: ev.month,
                    title: ev.title,
                    badge: ev.badge,
                    time: ev.time,
                    description: ev.description,
                    accent: _accent,
                    filter: _filter,
                    event_type: ev.event_type,
                    cta: _cta,
                    capacity: ev.capacity
                }]) %}
            {% endfor %}
        {% endif %}

        <ul class="bv-event-list">
            {% for event in events_list %}
                {% include 'partials/event_card.html.twig' with { event: event, inList: true } %}
            {% endfor %}
        </ul>
        {# Shown by the filter JS only when "Mine aktiviteter" is active and the
           viewer is signed up to nothing — otherwise an empty calendar reads as
           broken. #}
        {% if grav.user.authenticated and feature_enabled('event_rsvp') %}
        <p class="bv-event-list__empty-mine" data-empty-mine hidden>Du er endnu ikke tilmeldt nogen aktiviteter. Vælg &laquo;Alle aktiviteter&raquo; for at se, hvad der sker.</p>
        {% endif %}
    </div>
</section>
