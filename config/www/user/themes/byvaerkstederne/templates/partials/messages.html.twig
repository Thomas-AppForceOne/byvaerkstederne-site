{# Site-shell flash-message renderer.
   Surfaces Grav's session messages (login/email plugin flashes such as the
   activation-pending and activation-confirmed notices, reset confirmations,
   and form errors) inside the themed shell. Without this, the stock plugin
   page templates' `{% include 'partials/messages.html.twig' %}` would fall
   back to the unstyled admin-theme partial, and flashes redirected to `/`
   (WI-2) would not render at all because the site layout never emitted them.

   `grav.messages.fetch(scope)` is read-once: fetching clears the queue, so
   each flash shows exactly once. Scopes Grav uses: 'error', 'warning',
   'info', 'success'. #}
{% set bv_message_scopes = ['error', 'warning', 'info', 'success'] %}
{% set bv_all_messages = [] %}
{% for scope in bv_message_scopes %}
    {% for message in grav.messages.fetch(scope) %}
        {# Skip blank flashes. Some success confirmations (login/logout) are
           intentionally emptied via the PLUGIN_LOGIN.* language overrides so
           their transient bar no longer renders; the plugin still enqueues an
           (empty) message, which we drop here. #}
        {% if message.message|trim is not empty %}
        {% set bv_all_messages = bv_all_messages|merge([{ 'scope': scope, 'message': message.message }]) %}
        {% endif %}
    {% endfor %}
{% endfor %}
{% if bv_all_messages|length %}
<div class="bv-messages" role="status" aria-live="polite">
    {% for m in bv_all_messages %}
        {# Normalise Grav's four scopes to the success/error contract the auth
           surface asserts on, keeping a distinct amber for warnings. The
           forgot/reset "instructions sent" confirmation is flashed by the login
           plugin as scope 'info' (neutral, no-enumeration wording); on the auth
           surface that reads as a positive confirmation, so info -> success.
           error -> error; warning -> warning. Styling lives in theme.css
           (.bv-message / .bv-message--{success,error,warning}). #}
        {% set bv_variant = m.scope == 'error' ? 'error' : (m.scope == 'warning' ? 'warning' : 'success') %}
        {# |raw matches Grav's stock messages partial (flashes may carry
           intentional markup, e.g. links). Any USER-CONTROLLED value that
           reaches a flash must therefore be gated at the source: the only such
           value on the auth surface is the registration fullname, which is
           constrained to exclude angle brackets in register.md so it cannot
           inject markup here. Do not interpolate unsanitised user input into a
           flash rendered by this partial. #}
        <div class="bv-message bv-message--{{ bv_variant }}">
            {{ m.message|raw }}
        </div>
    {% endfor %}
</div>
{% endif %}
