{# Theme shadow of the login plugin's partials/forgot-form.html.twig.
   Identical to the stock partial EXCEPT it drops the `{{ content|raw }}` line
   that injected the English markdown boilerplate from the plugin's
   pages/forgot.md ("Recover your password / Enter your email ..."). The themed
   Danish copy in forgot.html.twig is the only prose shown. Fields, the CSRF
   nonce, and the submit task are unchanged — no plugin PHP is touched.
   (auth-surface UI/UX spec) #}
{% set layout = layout ?? form.layout ?? 'default' %}
{% set field_layout = layout %}

{% set client_side_validation = form.client_side_validation is not null ? form.client_side_validation : config.plugins.form.client_side_validation|default(true) %}
{% set inline_errors = form.inline_errors is not null ? form.inline_errors : config.plugins.form.inline_errors(false) %}

<section id="grav-login">
  <form method="post" action="{{ (base_url_relative ~ uri.path)|e }}">
    {% for field in form.fields %}
      {% set field = prepare_form_field(field, field_name) %}
      {% if field %}
        {% set value = field.name == 'username' ? username : '' %}
        {% set field_templates = include_form_field(field.type, field_layout) %}
        {% block field %}
          {% include field_templates ignore missing %}
        {% endblock %}
      {% endif %}
    {% endfor %}

    <div class="form-actions secondary-accent">
        <button type="submit" class="button primary bv-btn bv-btn--primary bv-btn--lg bv-btn--full" name="task" value="login.forgot">{{ "PLUGIN_LOGIN.BTN_SEND_INSTRUCTIONS"|t }}</button>
    </div>

    {{ nonce_field('forgot-form', 'forgot-form-nonce')|raw }}
  </form>
</section>
