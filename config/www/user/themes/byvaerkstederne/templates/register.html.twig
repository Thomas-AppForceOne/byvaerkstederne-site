{# Account creation, rendered inside the shared floating auth card
   (partials/auth_card.html.twig) — same identity as login/forgot/reset. The
   registration form itself still uses Grav's form rendering (forms/form.html.twig)
   for proper nonce/CSRF handling; .bv-register-card carries the field styling.
   No plugin PHP is touched. (auth-surface UI/UX) #}
{% extends 'partials/base.html.twig' %}

{# Flash renders inside the card; suppress base's top-of-page flash. #}
{% block flash %}{% endblock %}

{% block body %}
{% embed 'partials/auth_card.html.twig' %}
    {% block auth_title %}Bliv en del af v&aelig;rkstedet{% endblock %}
    {% block auth_intro %}
        <p class="bv-body-lg">Byg, skab og deltag i f&aelig;llesskabet. Opret dit medlemskab herunder for at f&aring; adgang til maskiner, kurser og netv&aelig;rk.</p>
    {% endblock %}
    {% block auth_form %}
        <style>
          /* Honeypot anti-spam field (form field "website", type: honeypot). Hidden
             from humans; bots fill it and the forms plugin rejects the submission
             server-side. The field also carries aria-hidden + tabindex=-1; this rule
             hides it visually regardless of the form plugin's inline_css setting. */
          .form-honeybear { position: absolute !important; left: -10000px !important; width: 1px; height: 1px; overflow: hidden; }
        </style>

        {# Form Card — use Grav's form rendering for proper nonce/CSRF handling #}
        <div class="bv-register-card">
            {% include "forms/form.html.twig" with {form: forms('registration')} %}
        </div>

        {# Redirect back to referring page after registration #}
        {% set redirect_to = uri.query('redirect')|default('/') %}
        <script>
        (function() {
            var redirect = '{{ redirect_to }}';
            if (redirect && redirect !== '/') {
                var form = document.querySelector('.bv-register-card form');
                if (form) {
                    form.action = form.action + (form.action.indexOf('?') > -1 ? '&' : '?') + 'redirect=' + encodeURIComponent(redirect);
                }
            }

            // Convert tooltip attributes to visible help text
            document.querySelectorAll('.bv-register-card .tooltip[data-tooltip]').forEach(function(el) {
                var helpDiv = document.createElement('div');
                helpDiv.className = 'bv-help-text';
                helpDiv.textContent = el.getAttribute('data-tooltip');
                var formLabel = el.closest('.form-label');
                if (formLabel) {
                    formLabel.parentNode.insertBefore(helpDiv, formLabel.nextSibling);
                }
                el.removeAttribute('data-tooltip');
            });

            // Client-side form validation
            var form = document.querySelector('.bv-register-card form');
            if (form) {
                form.addEventListener('submit', function(e) {
                    // Remove previous errors
                    document.querySelectorAll('.bv-field-error').forEach(function(el) { el.remove(); });
                    var hasError = false;

                    function showError(field, message) {
                        hasError = true;
                        var msg = document.createElement('div');
                        msg.className = 'bv-field-error';
                        msg.style.cssText = 'background: #ffdad6; color: #93000a; padding: 0.75rem 1rem; margin-top: 0.5rem; font-weight: 600; font-size: 0.8rem;';
                        msg.textContent = message;
                        field.parentNode.appendChild(msg);
                    }

                    // Username validation
                    var username = form.querySelector('input[name="data[username]"]');
                    if (username) {
                        var uval = username.value;
                        if (!/^[a-z0-9_-]{3,16}$/.test(uval)) {
                            showError(username, 'Brugernavn skal være 3-16 tegn med kun små bogstaver, tal, bindestreg eller understregning.');
                        }
                    }

                    // Password strength validation (WI-5/WI-7). Target the
                    // first password field (password1) explicitly now that the
                    // form has a confirmation field (password2). This .length +
                    // /[a-z]/ + /[A-Z]/ + /[0-9]/ chain is the canonical
                    // client-side policy proven equivalent to the server-side
                    // pwd_regex by the shared truth-table fixture/test.
                    var pwd = form.querySelector('input[name="data[password1]"]') || form.querySelector('input[type="password"]');
                    if (pwd) {
                        var val = pwd.value;
                        var errors = [];
                        if (val.length < 8) errors.push('mindst 8 tegn');
                        if (!/[a-z]/.test(val)) errors.push('mindst ét lille bogstav');
                        if (!/[A-Z]/.test(val)) errors.push('mindst ét stort bogstav');
                        if (!/[0-9]/.test(val)) errors.push('mindst ét tal');
                        if (errors.length > 0) {
                            showError(pwd, 'Adgangskoden mangler: ' + errors.join(', ') + '.');
                        }
                    }

                    // Password confirmation match (WI-7). Mirror the server-side
                    // validate_password1_and_password2 enforcement client-side so
                    // a typo is caught before submit.
                    var pwd2 = form.querySelector('input[name="data[password2]"]');
                    if (pwd && pwd2 && pwd.value !== pwd2.value) {
                        showError(pwd2, 'Adgangskoderne er ikke ens. Skriv den samme adgangskode i begge felter.');
                    }

                    if (hasError) {
                        e.preventDefault();
                        var firstError = document.querySelector('.bv-field-error');
                        if (firstError) firstError.scrollIntoView({behavior: 'smooth', block: 'center'});
                    }
                });
            }
        })();
        </script>
    {% endblock %}
    {% block auth_footer %}
        <div style="text-align: center; padding-top: var(--space-8);">
            <a href="/login" class="bv-label" style="color: var(--outline); text-decoration: underline; text-underline-offset: 4px;">
                Har du allerede en profil? Log ind her
            </a>
        </div>
    {% endblock %}
{% endembed %}
{% endblock %}
