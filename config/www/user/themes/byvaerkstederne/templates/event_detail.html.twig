{% extends 'partials/base.html.twig' %}

{# ============================================================================
   Event detail — /begivenheder/<key> (frontend event CRUD, net-new view).
   Data arrives as `em_event` / `em_event_key`, injected by the event-manager
   plugin, which has already enforced read visibility (§8.2): published for
   anyone, unpublished/archived for owner/super only. The header summary
   composes the canonical partials/event_card.html.twig — the single event-
   card render chokepoint — followed by a fuller body.
   ============================================================================ #}

{% set ev = em_event %}

{# Same accent/filter discipline as modular/event_list.html.twig: accent from
   button_style (visual token), filter from group (behaviour ID). #}
{% set filter_map = {makerspace: 'makerspace', krea: 'krea', groent: 'groent', kulturhus: 'kulturhus', alle: 'all'} %}
{% set _accent = ev.button_style|default('primary') %}
{# No CTA on the detail card — the event RSVP feature adds the live
   Tilmeld/Interesseret action here (button_url is retired). #}
{% set _cta = null %}
{% set _card = {
    day: ev.event_date|date('j'),
    month: ev.event_date|date('M'),
    title: ev.title,
    badge: ev.badge,
    time: ev.event_time,
    accent: _accent,
    filter: filter_map[ev.group]|default(ev.group),
    price: ev.price,
    cta: _cta,
    capacity: ev.capacity,
    featured: false
} %}

{% block body %}
<section class="bv-section--sm" aria-label="Begivenhed">
    <div class="bv-container">

        {# Owner/super preview notice for events the public cannot see #}
        {% if not ev.published or ev.archived %}
        <div class="bv-messages" role="status">
            <div class="bv-message bv-message--warning">
                {% if ev.archived %}
                    Denne begivenhed er arkiveret og vises ikke offentligt.
                {% else %}
                    Denne begivenhed er en kladde og vises ikke offentligt endnu.
                {% endif %}
            </div>
        </div>
        {% endif %}

        {% include 'partials/event_card.html.twig' with { event: _card, inList: false } %}

        <article class="bv-event-detail">
            {% if ev.description %}
                <p class="bv-body-lg">{{ ev.description }}</p>
            {% endif %}

            <dl class="bv-event-detail__facts">
                <div><dt>Dato</dt><dd>{{ ev.event_date|date('j. F Y') }}</dd></div>
                {% if ev.event_time %}<div><dt>Tidspunkt</dt><dd>{{ ev.event_time }}</dd></div>{% endif %}
                {% if ev.location %}<div><dt>Lokation</dt><dd>{{ ev.location }}</dd></div>{% endif %}
                {% if ev.capacity %}<div><dt>Kapacitet</dt><dd>{{ ev.capacity }}</dd></div>{% endif %}
                {% if ev.price %}<div><dt>Pris</dt><dd>{{ ev.price }}</dd></div>{% endif %}
            </dl>

            <div class="bv-event-detail__actions">
                <a class="bv-btn bv-btn--secondary" href="/vaerkstedskalenderen">Tilbage til kalenderen</a>
                {% if grav.user.authenticated and grav.user.authorized
                      and (grav.user.username == ev.owner or grav.user.authorize('admin.super')) %}
                    <a class="bv-btn bv-btn--primary" href="/begivenheder/rediger/{{ em_event_key }}">Rediger</a>
                {% endif %}
            </div>
        </article>
    </div>
</section>
{% endblock %}
