{# Result page for the admin access-request mail links
   (/konto/access-request/approve|reject). The account-manager plugin
   substitutes this page after processing and injects `ar_result`:
     outcome:   'approved' | 'rejected' | null (null = invalid/expired/
                already-processed token — render the neutral card, no data)
     applicant: { username, fullname, email, state, roles: [readable names] }
     request:   { role_label, motivation, requested_at }
   Danish visitor copy, English identifiers. #}
{% extends 'partials/base.html.twig' %}

{% block flash %}{% endblock %}

{% block body %}
{% embed 'partials/auth_card.html.twig' with { auth_card_class: 'bv-auth-card--account' } %}
    {% block auth_title %}
        {%- if ar_result.outcome == 'approved' -%}Anmodning godkendt
        {%- elseif ar_result.outcome == 'rejected' -%}Anmodning afvist
        {%- else -%}Anmodningen kunne ikke behandles
        {%- endif -%}
    {% endblock %}
    {% block auth_intro %}
        {% if ar_result.outcome == 'approved' %}
            <p class="bv-body-lg">Ansøgeren har fået rollen <strong>{{ ar_result.request.role_label }}</strong> og kan bruge den fra sit næste login.</p>
        {% elseif ar_result.outcome == 'rejected' %}
            <p class="bv-body-lg">Anmodningen er afvist. Ansøgeren kan anmode igen efter en karensperiode.</p>
        {% else %}
            <p class="bv-body-lg">Linket er ugyldigt, udløbet eller allerede behandlet.</p>
        {% endif %}
    {% endblock %}
    {% block auth_form %}
        {% if ar_result.outcome %}
        <div class="bv-ar-result">
            <section class="bv-account-section" aria-labelledby="ar-applicant-heading">
                <h2 id="ar-applicant-heading" class="bv-headline bv-account-section__heading">Ansøger</h2>
                <dl class="bv-ar-result__facts">
                    <dt>Brugernavn</dt>
                    <dd>{{ ar_result.applicant.username }}</dd>
                    <dt>Navn</dt>
                    <dd>{{ ar_result.applicant.fullname ?: '—' }}</dd>
                    <dt>E-mail</dt>
                    <dd><a href="mailto:{{ ar_result.applicant.email }}">{{ ar_result.applicant.email }}</a></dd>
                    <dt>Kontostatus</dt>
                    <dd>{{ ar_result.applicant.state == 'enabled' ? 'Aktiveret' : 'Ikke aktiveret' }}</dd>
                    <dt>Roller nu</dt>
                    <dd>
                        {%- if ar_result.applicant.roles is not empty -%}
                            {{ ar_result.applicant.roles|join(', ') }}
                        {%- else -%}
                            Medlem (ingen særlige roller)
                        {%- endif -%}
                    </dd>
                </dl>
            </section>
            <section class="bv-account-section" aria-labelledby="ar-request-heading">
                <h2 id="ar-request-heading" class="bv-headline bv-account-section__heading">Anmodningen</h2>
                <dl class="bv-ar-result__facts">
                    <dt>Ansøgt rolle</dt>
                    <dd>{{ ar_result.request.role_label }}</dd>
                    <dt>Ansøgt den</dt>
                    <dd>{{ ar_result.request.requested_at ? ar_result.request.requested_at|date('d.m.Y \\k\\l. H:i') : '—' }}</dd>
                    <dt>Motivation</dt>
                    <dd>{{ ar_result.request.motivation ?: '—' }}</dd>
                </dl>
            </section>
        </div>
        {% endif %}
        <div class="bv-ar-result__actions">
            <a class="bv-btn bv-btn--primary" href="/">Til forsiden</a>
        </div>
    {% endblock %}
{% endembed %}
{% endblock %}
